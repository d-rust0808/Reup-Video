{
  "name": "reup-video-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "preview": "vite preview",
    "electron:dev": "node ./scripts/electron-dev.cjs",
    "electron:dev:reload": "node ./scripts/electron-dev.cjs --reload",
    "electron:build": "vite build && node scripts/build-desktop.cjs",
    "electron:build:win": "vite build && node scripts/build-desktop.cjs win",
    "electron:build:mac": "vite build && node scripts/build-desktop.cjs mac",
    "electron:pack": "vite build && node scripts/build-desktop.cjs --dir",
    "electron:pack:win": "vite build && node scripts/build-desktop.cjs win --dir",
    "electron:pack:mac": "vite build && node scripts/build-desktop.cjs mac --dir"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wait-on": "^9.1.0"
  }
}
