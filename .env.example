# Optional. Missing this file is fine — Reup uses the system `agy` CLI.
# Do not put DeepSeek / Jamendo API keys here unless you explicitly switch engines.
# GPU_CONCURRENCY must stay 1 on 4 GB VRAM.

DESKTOP_PLATFORM=win
HOST=127.0.0.1
PORT=6000

MAX_CONCURRENT_JOBS=16
GPU_CONCURRENCY=1
ONNX_INTRA_OP_THREADS=16
TTS_CONCURRENCY=10
TTS_ONNX_THREADS=6
STT_CPU_THREADS=16
STT_WORKERS=4
SUBTITLE_TRANSLATOR=agy
