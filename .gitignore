# Module runtime temp and output directories
app/modules/tmp/
app/modules/output/
app/modules/models/*
!app/modules/models/.gitkeep
app/modules/videotrans/cfg.json
app/modules/videotrans/params.json

# Large AI model weights / binaries
*.onnx
*.bin
*.pt
*.pth
*.safetensors

# Third party repo outputs
pyvideotrans_repo/output/*
